{
  "name": "kleap-astro-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "postinstall": "node -e \"const fs=require('fs'),f='node_modules/astro/dist/assets/services/sharp.js';try{const s=fs.readFileSync(f,'utf8');if(/failOnError:\\s*false/.test(s)){fs.writeFileSync(f,s.replace(/failOnError:\\s*false/,'failOn: \\\"none\\\"'));console.log('[kleap] astro sharp service: failOnError:false -> failOn:none')}}catch(e){console.warn('[kleap] astro sharp failOn shim skipped: '+e.message)}\" && node kleap-patch-compiler.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/compiler": "2.13.1",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@paypal/react-paypal-js": "^9.2.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "@better-auth/api-key": "1.6.23"
  }
}
